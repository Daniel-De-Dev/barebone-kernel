ENTRY(_start)

BASE_ADDRESS = @kernelAddress@;

MEMORY
{
  KERNEL (rwx) : ORIGIN = @kernelAddress@, LENGTH = @kernelRegionSize@
}

SECTIONS
{
  . = BASE_ADDRESS;

  .text : {
    KEEP(*(.text.init))
    *(.text .text.*)
  } > KERNEL

  .rodata : {
    *(.srodata .srodata.*)
    *(.rodata .rodata.*)
  } > KERNEL

  .data : {
    . = ALIGN(8);

    __global_pointer$ = . + 0x800;

    *(.sdata .sdata.*)
    *(.data .data.*)
  } > KERNEL

  .bss (NOLOAD) : {
    . = ALIGN(8);

    _bss_start = .;

    *(.sbss .sbss.*)
    *(.bss .bss.*)
    *(COMMON)

    . = ALIGN(8);
    _bss_end = .;
  } > KERNEL

  .stack (NOLOAD) : {
    . = ALIGN(16);

    _stack_start = .;
    . += 16K;
    _stack_end = .;
  } > KERNEL
}
